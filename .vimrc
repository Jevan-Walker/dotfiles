colorscheme habamax

syntax on
filetype plugin indent on

set clipboard=unnamedplus
inoremap jk <Esc>
nnoremap B ^
vnoremap B ^
nnoremap W g_
vnoremap W g_
let mapleader = " "

set mouse=a
set tabstop=4
set shiftwidth=4
set expandtab
set number
set relativenumber
set ignorecase
set smartcase
set incsearch
set autoindent
set autochdir


map gf :e <cfile><CR>
